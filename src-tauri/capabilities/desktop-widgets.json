{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-widgets",
  "description": "Desktop widget windows (label dw-<widget id>): app events, moving and resizing the frameless window.",
  "platforms": ["windows"],
  "windows": ["dw-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
